# Blink payment configuration
# Copy this file to .env or define these variables in the backend process.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-secret

PAYMENT_BLINK_ENABLED=false
PAYMENT_BLINK_API_URL=https://api.blink.sv/graphql
PAYMENT_BLINK_WS_URL=wss://ws.blink.sv/graphql
PAYMENT_BLINK_API_KEY=
PAYMENT_BLINK_WALLET_ID=
# Required when charging BIF through Blink: current satoshis per BIF.
PAYMENT_BLINK_BIF_SATS=0

# Bitlibera credentials (fill these with values issued by Bitlibera).
PAYMENT_BITLIBERA_ENABLED=false
PAYMENT_BITLIBERA_API_URL=
PAYMENT_BITLIBERA_API_KEY=
PAYMENT_BITLIBERA_SECRET=
PAYMENT_BITLIBERA_MERCHANT_ID=
PAYMENT_BITLIBERA_CALLBACK_URL=

# Lumicash configuration. Enable only with the official API contract and credentials.
PAYMENT_LUMICASH_ENABLED=false
PAYMENT_LUMICASH_API_URL=
PAYMENT_LUMICASH_API_KEY=
PAYMENT_LUMICASH_SECRET=
PAYMENT_LUMICASH_MERCHANT_ID=
PAYMENT_LUMICASH_CALLBACK_URL=

# SMTP is required to deliver password reset codes outside development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@schoolon.com
PAYMENT_PLATFORM_FEE_RATE=0.05
CERTIFICATE_PUBLIC_BASE_URL=http://localhost:5173

# Firebase local development credentials.
# Point to a real service-account JSON file when you want push notifications to work.
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json
